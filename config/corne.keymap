#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    chosen { zmk,underglow = &led_strip; };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // .--------------------------------------------------------------.       .-----------------------------------------------------------.
            // |   ESC        |    Q    |    W   |   E    |    R    |    T    |       |   Y   |    U    |    I    |    O    |     P    |    \     |
            // |--------------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   CTRL/Tab   |    A    |    S   |   D    |    F    |    G    |       |   H   |    J    |    K    |    L    |     ;    |     '    |
            // |--------------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   SHFT       |    Z    |    X   |   C    |    V    |    B    |       |   N   |    M    |    ,    |    .    |     /    | ` | ALT  |
            // '---------------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
            //                                   |  GUI   |   MO1   |   ENT   |       |  SPC  |   BKSP  |  CAPS   |
            //                                   '--------+---------+---------'       '-------+---------+---------'

            bindings = <
&kp TAB         &kp Q    &kp W  &kp E         &kp R               &kp T        &kp Y            &kp U        &kp I            &kp O       &kp P          &kp DELETE
&kp LEFT_ALT    &kp A    &kp S  &kp D         &kp F               &kp G        &kp H            &kp J        &kp K            &kp L       &kp SEMICOLON  &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &lt 7 Z  &kp X  &kp C         &kp V               &kp B        &kp N            &kp M        &kp COMMA        &kp PERIOD  &kp SLASH      &trans
                                &lt 5 ESCAPE  &mt LEFT_GUI ENTER  &lt 1 TAB    &lt 2 BACKSPACE  &lt 1 SPACE  &kp RIGHT_SHIFT
            >;
        };

        num {
            bindings = <
&trans      &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR        &kp PERCENT       &kp CARET        &kp AMPERSAND      &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&kp LALT    &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6     &kp NUMBER_7       &kp NUMBER_8     &kp NUMBER_9          &kp NUMBER_0           &kp RALT
&kp LSHIFT  &trans           &kp TILDE     &kp GRAVE     &kp LEFT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &trans           &trans                &trans                 &trans
                                           &kp LCTRL     &trans            &trans            &trans           &kp LEFT_GUI       &kp RIGHT_SHIFT
            >;
        };

        func {
            bindings = <
&kp F1     &kp F2    &kp F3   &kp F4          &kp F5       &kp F6           &kp F7    &kp F8    &kp F9      &kp F10    &kp F11  &kp F12
&kp LALT   &kp HOME  &kp END  &kp UNDERSCORE  &trans       &kp PAGE_UP      &kp LEFT  &kp DOWN  &kp UP      &kp RIGHT  &trans   &kp RIGHT_ALT
&kp LSHFT  &trans    &trans   &kp K_COPY      &kp K_PASTE  &kp PAGE_DOWN    &trans    &trans    &trans      &trans     &trans   &trans
                              &kp LCTRL       &trans       &trans           &trans    &trans    &kp RSHIFT
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans         &trans        &trans            &trans          &trans    &kp K_REDO    &kp K_PASTE    &kp K_COPY     &kp K_CUT     &kp K_UNDO  &trans
&trans  &kp LEFT_META  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &kp CAPSLOCK  &kp LEFT       &kp DOWN       &kp UP_ARROW  &kp RIGHT   &trans
&trans  &trans         &trans        &trans            &trans          &trans    &kp INSERT    &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &trans
                                     &trans            &trans          &trans    &kp RET       &kp BACKSPACE  &kp DELETE
            >;
        };

        media {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        sym {
            bindings = <
&trans  &kp SEMICOLON  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_BRACE         &kp RIGHT_BRACE    &trans  &trans           &trans             &trans         &trans          &trans
&trans  &kp COLON      &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_META  &trans
&trans  &kp TILDE      &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE           &trans  &trans           &trans             &trans         &trans          &trans
                                        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &trans           &trans
            >;
        };

        addtl {
            bindings = <
&trans  &trans  &trans           &trans          &trans           &trans    &trans  &trans           &trans  &trans  &trans  &trans
&trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_TOG  &trans    &trans  &rgb_ug RGB_EFF  &trans  &trans  &trans  &trans
&trans  &trans  &trans           &trans          &trans           &trans    &trans  &trans           &trans  &trans  &trans  &trans
                                 &trans          &trans           &trans    &trans  &trans           &trans
            >;
        };
    };
};
