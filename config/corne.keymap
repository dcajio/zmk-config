#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip { chain-length = <27>; };

/ {
    chosen { zmk,underglow = &led_strip; };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // .--------------------------------------------------------------.       .-----------------------------------------------------------.
            // |   ESC        |    Q    |    W   |   E    |    R    |    T    |       |   Y   |    U    |    I    |    O    |     P    |    \     |
            // |--------------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   CTRL/Tab   |    A    |    S   |   D    |    F    |    G    |       |   H   |    J    |    K    |    L    |     ;    |     '    |
            // |--------------+---------+--------+--------+---------+---------|       |-------+---------+---------+---------+----------+----------|
            // |   SHFT       |    Z    |    X   |   C    |    V    |    B    |       |   N   |    M    |    ,    |    .    |     /    | ` | ALT  |
            // '---------------------------------+--------+---------+---------+       |-------+---------+---------+-------------------------------'
            //                                   |  GUI   |   MO1   |   ENT   |       |  SPC  |   BKSP  |  CAPS   |
            //                                   '--------+---------+---------'       '-------+---------+---------'

            bindings = <
&kp Q   &kp W            &kp E           &kp R         &kp T              &kp Y        &kp U         &kp I              &kp O         &kp P            &kp LEFT_BRACKET          &kp RIGHT_BRACKET
&trans  &hm LEFT_META A  &hm LEFT_ALT S  &hm LCTRL D   &hm RIGHT_SHIFT F  &kp G        &kp H         &hm RIGHT_SHIFT J  &hm RCTRL K   &hm RIGHT_ALT L  &hm RIGHT_META SEMICOLON  &kp SINGLE_QUOTE
&trans  &lt 7 Z          &kp X           &kp C         &kp V              &kp B        &kp N         &kp M              &kp COMMA     &kp PERIOD       &kp SLASH                 &trans
                                         &lt 5 ESCAPE  &lt 4 SPACE        &lt 3 TAB    &lt 6 RETURN  &lt 1 BACKSPACE    &lt 2 DELETE
            >;
        };

        num {
            bindings = <
&trans  &kp LEFT_PARENTHESIS  &kp N7        &kp N8        &kp N9        &kp RIGHT_PARENTHESIS    &trans  &trans           &trans             &trans         &trans          &trans
&trans  &kp SEMICOLON         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL                &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_META  &trans
&trans  &kp GRAVE             &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH            &trans  &trans           &trans             &trans         &trans          &trans
                                            &kp PERIOD    &kp NUMBER_0  &kp MINUS                &trans  &trans           &trans
            >;
        };

        func {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9     &kp PRINTSCREEN    &trans  &trans           &trans             &trans         &trans          &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6     &kp SCROLLLOCK     &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_META  &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3     &kp PAUSE_BREAK    &trans  &trans           &trans             &trans         &trans          &trans
                         &trans  &kp SPACE  &kp TAB            &trans  &trans           &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans         &trans        &trans            &trans          &trans    &kp K_REDO    &kp K_PASTE    &kp K_COPY     &kp K_CUT     &kp K_UNDO  &trans
&trans  &kp LEFT_META  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans    &kp CAPSLOCK  &kp LEFT       &kp DOWN       &kp UP_ARROW  &kp RIGHT   &trans
&trans  &trans         &trans        &trans            &trans          &trans    &kp INSERT    &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP   &kp END     &trans
                                     &trans            &trans          &trans    &kp RET       &kp BACKSPACE  &kp DELETE
            >;
        };

        media {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        sym {
            bindings = <
&trans  &kp SEMICOLON  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_BRACE         &kp RIGHT_BRACE    &trans  &trans           &trans             &trans         &trans          &trans
&trans  &kp COLON      &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_META  &trans
&trans  &kp TILDE      &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE           &trans  &trans           &trans             &trans         &trans          &trans
                                        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans  &trans           &trans
            >;
        };

        addtl {
            bindings = <
&trans  &trans  &trans           &trans          &trans           &trans    &trans  &trans           &trans  &trans  &trans  &trans
&trans  &trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_TOG  &trans    &trans  &rgb_ug RGB_EFF  &trans  &trans  &trans  &trans
&trans  &trans  &trans           &trans          &trans           &trans    &trans  &trans           &trans  &trans  &trans  &trans
                                 &trans          &trans           &trans    &trans  &trans           &trans
            >;
        };
    };
};
